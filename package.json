{
  "name": "cadweave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "pnpm --filter @cadweave/desktop build",
    "typecheck": "pnpm --filter @cadweave/desktop typecheck",
    "test": "pnpm --filter @cadweave/desktop test",
    "package:win": "pnpm --filter @cadweave/desktop package:win",
    "test:worker": "uv run --project workers/cad-python pytest workers/cad-python/tests",
    "test:desktop": "pnpm --filter @cadweave/desktop exec node tests/electron-smoke.cjs",
    "test:ui": "pnpm --filter @cadweave/desktop exec node tests/ui-interactions.cjs",
    "start": "node scripts/launch-desktop.cjs",
    "format": "pnpm --filter @cadweave/desktop exec prettier --write src electron.vite.config.ts tests/*.ts"
  }
}
