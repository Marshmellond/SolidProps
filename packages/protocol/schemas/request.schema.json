{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CadWeave v1 Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "method", "params", "protocolVersion"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "protocolVersion": {"const": 1},
    "method": {"enum": ["discover", "connect", "snapshot", "apply", "disconnect"]},
    "params": {"type": "object"}
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "propertyName", "oldValue", "newValue"],
      "properties": {
        "modelId": {"type": "string", "maxLength": 65536, "pattern": "^[^\\u0000]*$"},
        "propertyName": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "^[^\\u0000]*\\S[^\\u0000]*$"},
        "oldValue": {"type": "string", "maxLength": 65536, "pattern": "^[^\\u0000]*$"},
        "newValue": {"type": "string", "maxLength": 65536, "pattern": "^[^\\u0000]*$"},
        "operation": {"enum": ["add", "update", "delete"], "default": "update"}
      },
      "allOf": [
        {"if": {"required": ["operation"], "properties": {"operation": {"const": "add"}}}, "then": {"properties": {"oldValue": {"const": ""}}}},
        {"if": {"required": ["operation"], "properties": {"operation": {"const": "delete"}}}, "then": {"properties": {"newValue": {"const": ""}}}}
      ]
    }
  },
  "allOf": [{
    "if": {"properties": {"method": {"const": "apply"}}},
    "then": {"properties": {"params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "changes", "confirmSave"],
      "properties": {
        "snapshotId": {"type": "string"},
        "confirmSave": {"const": true},
        "changes": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/change"}}
      }
    }}}
  }]
}
